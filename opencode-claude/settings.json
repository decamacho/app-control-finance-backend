{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run lint)",
      "Bash(pnpm run format)",
      "Bash(pnpm run test*)",
      "Bash(pnpm run build)",
      "Bash(pnpm run start:dev)",
      "Bash(docker ps)",
      "Bash(docker-compose up -d)",
      "Bash(docker-compose down)",
      "Read(src/**)",
      "Read(test/**)",
      "Edit(src/**)",
      "Edit(test/**)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(docker-compose down -v)",
      "Bash(psql*DROP DATABASE*)"
    ],
    "additionalDirectories": []
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-summary.sh"
          }
        ]
      }
    ]
  },

  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5433/wallet_ai"
      ],
      "description": "Read-only introspection of the local Wallet AI PostgreSQL schema (tables, columns, indexes) for schema-aware suggestions."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "description": "PR creation, issue lookup, and code review context from the Wallet AI GitHub repository."
    }
  },

  "model": "claude-sonnet-4-6",
  "cleanupPeriodDays": 30
}